{
  "schema": 2,
  "proto": 1,
  "product": { "zh": "ESP 虚拟键盘", "en": "ESP Virtual Keyboard" },
  "defaultLocale": "zh",
  "variants": [
    { "id": "default", "label": { "zh": "标准固件", "en": "Standard" } }
  ],
  "switches": {
    "write":    { "default": true,  "visible": true },
    "update":   { "default": true,  "visible": false },
    "override": { "default": false, "visible": true },
    "erase":    { "default": false, "visible": true }
  },
  "groups": [
    { "id": "network", "label": { "zh": "网络", "en": "Network" } }
  ],
  "fields": [
    { "key": "ssid", "group": "network",
      "label": { "zh": "WiFi 名称 (SSID)", "en": "WiFi SSID" },
      "type": "text", "maxlength": 32,
      "placeholder": { "zh": "留空 = 不修改", "en": "empty = unchanged" } },
    { "key": "pass", "group": "network",
      "label": { "zh": "WiFi 密码", "en": "WiFi password" },
      "type": "password", "sensitive": true, "maxlength": 63,
      "placeholder": { "zh": "留空 = 不修改", "en": "empty = unchanged" } }
  ],
  "protocol": {
    "ping": "ping",
    "pongEvt": "pong",
    "status": "status",
    "statusEvt": "status",
    "credsCmd": "wifi",
    "credsSavedEvt": "wifi_saved",
    "clearCmd": "wifi_clear",
    "clearAckEvt": "wifi_saved",
    "wifiConnectingEvt": "wifi_connecting",
    "wifiConnectedEvt": "wifi_connected",
    "wifiFailedEvt": "wifi_failed",
    "errorEvt": "error"
  },
  "actions": [
    { "id": "flash", "type": "flash",
      "label": { "zh": "开始升级", "en": "Flash firmware" } },
    { "id": "submit", "type": "submit",
      "label": { "zh": "写入配置", "en": "Apply configuration" },
      "command": "wifi", "gate": "write",
      "static": { "write": true },
      "switches": ["override"],
      "waitFor": ["wifi_saved"],
      "followUp": {
        "waitFor": ["wifi_connected", "wifi_failed", "error"],
        "timeoutMs": 45000, "ifField": "ssid"
      } },
    { "id": "clear", "type": "custom",
      "label": { "zh": "清除配网信息", "en": "Clear provisioning" },
      "command": "wifi_clear",
      "static": { "groups": ["all"] },
      "waitFor": ["wifi_saved"] }
  ],
  "statusView": {
    "mode": "summary",
    "summary": [
      { "key": "compile",  "label": { "zh": "内置凭据", "en": "Built-in" }, "type": "bool" },
      { "key": "nvs",      "label": { "zh": "NVS 凭据", "en": "NVS" },      "type": "bool" },
      { "key": "override", "label": { "zh": "覆盖",     "en": "Override" }, "type": "bool" },
      { "key": "state",    "label": { "zh": "网络",     "en": "Network" },  "type": "state" },
      { "key": "ip",       "label": { "zh": "IP",       "en": "IP" },       "type": "value" }
    ]
  }
}
